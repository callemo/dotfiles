#!/bin/sh
# Minimalist install script.

root="$(cd "${0%/*}" && pwd -P)"
PATH="$root/bin:$PATH"

log()   { echo "${0##*/}: $*" >&2; }
fatal() { log "$@"; exit 1; }
usage() { echo "usage: ${0##*/} [-u]" >&2; }

update_plugins=0
while getopts :u f; do
	case $f in
	u)  update_plugins=1 ;;
	\?) usage; exit 2 ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || { usage; exit 2; }

cd "$root" || fatal "cd $root"
. "$root/lib/install"

# run fn target source on dir's dot files;
# target drops the $HOME prefix
eachdot() {
	local dir fn path p f sub
	dir=$1 fn=$2

	for path in "$dir"/dot.*; do
		[ -e "$path" ] || continue
		f=${path##*/}
		if [ "$f" = dot.config ]; then
			find "$path" -type f | while read -r p; do
				sub=${p#"$dir"/dot.config/}
				"$fn" "${f#dot}/$sub" "$p"
			done
		else
			"$fn" "${f#dot}" "$path"
		fi
	done
}

linkone() (
	target=$1 src=$2
	case $target in
	*/*) mkdir -p "$HOME/${target%/*}" ;;
	esac
	log "link $HOME/$target"
	ln -sf "$src" "$HOME/$target"
)

# remove symlink at target if it points to src
prunelink() (
	target=$1 src=$2
	[ -L "$HOME/$target" ] || exit 0
	old=$(readlink "$HOME/$target") || exit 0
	[ "$old" = "$src" ] || exit 0
	log "unlink $HOME/$target"
	rm -f "$HOME/$target"
)

# hosts with an override directory
hosts='t490 x270'

# remove host-scoped links; eachdot restores the current host's
prunehosts() {
	local h

	for h in $hosts; do
		eachdot "$root/$h" prunelink
	done
	# the pre-scoping layout put dot files at the repo root
	for path in dot.Xdefaults dot.fvwmrc dot.xsession; do
		prunelink "${path#dot}" "$root/$path"
	done
	prunelink '.local/share/applications/mupdf.desktop' \
		"$root/t490/applications/mupdf.desktop"
}

host=$(uname -n) || fatal 'uname -n failed'
hostdir=
for h in $hosts; do
	case $host in
	$h|$h.*) hostdir=$h ;;
	esac
done

prunehosts
eachdot "$root" linkone
if [ -n "$hostdir" ]; then
	eachdot "$root/$hostdir" linkone
	case $hostdir in
	t490) "$root/t490/setup.sh" || log 't490 setup failed' ;;
	esac
fi

[ -e "$HOME/.gitignore" ] || {
	log 'git exclude'
	ln -sf "$root/.gitignore" "$HOME/.gitignore"
	git config --global core.excludesfile "$HOME/.gitignore"
}

[ -e "$HOME/lib" ] || { log 'link lib'; ln -sf "$root/lib" "$HOME/lib"; }

# Wire init.sh into shell rc files; normalize any existing variant form.
for rc in "$HOME/.profile" "$HOME/.bashrc" "$HOME/.zshrc"; do
	[ -f "$rc" ] || continue
	fileline '^\. .*dotfiles/init\.sh' '. ~/dotfiles/init.sh' "$rc"
done

# Let btop inherit the terminal's ANSI palette.
if command -v btop >/dev/null 2>&1; then
	btopconf=$HOME/.config/btop/btop.conf
	mkdir -p "${btopconf%/*}"
	if [ ! -f "$btopconf" ]; then
		btop --default-config >"$btopconf" || {
			rm -f "$btopconf"
			fatal "create $btopconf"
		}
	fi
	fileline '^color_theme = ' 'color_theme = "TTY"' "$btopconf"
	fileline '^theme_background = ' 'theme_background = false' "$btopconf"
fi

getplugin() {
	if [ "$update_plugins" -eq 1 ]; then
		./vim/get -u "$@"
	else
		./vim/get "$@"
	fi
}

# Plugin data list
plugins=$(mktemp) || fatal "mktemp failed"
cat >"$plugins" <<EOF
https://github.com/tpope/vim-eunuch
https://github.com/tpope/vim-fugitive
https://github.com/tpope/vim-repeat
https://github.com/tpope/vim-surround
-o https://github.com/fatih/vim-go
EOF

while read -r flag url; do
	if [ -n "$url" ]; then
		log "vim plugin $flag $url"
		getplugin "$flag" "$url" </dev/null || fatal "vim plugin failed: $url"
	else
		log "vim plugin $flag"
		getplugin "$flag" </dev/null || fatal "vim plugin failed: $flag"
	fi
done <"$plugins"

# Prune undeclared start/ plugins
startdir="$HOME/.vim/pack/default/start"
[ -d "$startdir" ] || { rm -f "$plugins"; exit 0; }
for dir in "$startdir"/*; do
	[ -d "$dir" ] || continue
	printf '%s\n' "${dir##*/}"
done | awk -v startdir="$startdir" '
	FNR==NR { if (!/^-o/) { n=split($1,a,"/"); declared[a[n]]=1 } next }
	$0 in declared { next }
	{ print "install: vim prune " $0 > "/dev/stderr"
	  system("rm -rf " startdir "/" $0) }
' "$plugins" -
rm -f "$plugins"
