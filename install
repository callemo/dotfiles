#!/bin/sh
# Minimalist install script.

root="$(cd "${0%/*}" && pwd -P)"
PATH="$root/bin:$PATH"

log()   { echo "${0##*/}: $*" >&2; }
fatal() { log "$@"; exit 1; }

cd "$root" || fatal "cd $root"

# ensure line exists in file (ERE pattern matching)
# exit: 0=unchanged, 1=updated, >1=error
fileline() (
	pattern=$1 line=$2 file=$3
	grep -qxF "$line" "$file" 2>/dev/null && return 0
	if grep -qE "$pattern" "$file" 2>/dev/null; then
		sedpat=$(printf '%s\n' "$pattern" | sed 's/[@&]/\\&/g')
		sedtext=$(printf '%s\n' "$line" | sed 's/[@&]/\\&/g')
		overwrite "$file" sed -Ee 's@'"$sedpat"'.*@'"$sedtext"'@' "$file"
		log "$file: $pattern: replaced"
		return
	fi
	printf '%s\n' "$line" >>"$file"
	log "$file: $pattern: added"
)

linkdot() {
	local dir path f target sub
	dir=$1

	for path in "$dir"/dot.*; do
		[ -e "$path" ] || continue
		f=${path##*/}
		target="$HOME/${f#dot}"

		if [ "$f" != dot.config ]; then
			log "link $target"
			ln -sf "$path" "$target"
			continue
		fi
		find "$path" -type f | while read -r path; do
			sub=${path#"$dir"/dot.config/}
			mkdir -p "$HOME/.config/$(dirname "$sub")"
			log "link $HOME/.config/$sub"
			ln -sf "$path" "$HOME/.config/$sub"
		done
	done
}

prunex() {
	local path target old

	for path in dot.Xdefaults dot.fvwmrc dot.xsession \
		dot.config/picom/picom.conf; do
		case "$path" in
		dot.config/*) target=$HOME/.config/${path#dot.config/} ;;
		*) target=$HOME/${path#dot} ;;
		esac
		[ -L "$target" ] || continue
		old=$(readlink "$target") || continue
		[ "$old" = "$root/$path" ] || continue
		log "unlink $target"
		rm -f "$target"
	done
}

host=$(uname -n) || fatal 'uname -n failed'
case "$host" in
	t490|t490.*) xhost=t490 ;;
	x270|x270.*) xhost=x270 ;;
	*) xhost= ;;
esac

prunex
linkdot "$root"
[ -n "$xhost" ] && linkdot "$root/x11/$xhost"

[ -e "$HOME/.gitignore" ] || {
	log 'git exclude'
	ln -sf "$root/.gitignore" "$HOME/.gitignore"
	git config --global core.excludesfile "$HOME/.gitignore"
}

[ -e "$HOME/lib" ] || { log 'link lib'; ln -sf "$root/lib" "$HOME/lib"; }

# Wire init.sh into shell rc files; normalize any existing variant form.
for rc in "$HOME/.profile" "$HOME/.bashrc" "$HOME/.zshrc"; do
	[ -f "$rc" ] || continue
	fileline '^\. .*dotfiles/init\.sh' '. ~/dotfiles/init.sh' "$rc"
done

# Keep user tmux overrides across base configuration refreshes.
for tmpl in "$HOME/.local/share"/*/config/tmux/tmux.conf; do
	[ -f "$tmpl" ] || continue
	fileline '^source-file.*user\.conf' 'source-file -q ~/.config/tmux/user.conf' "$tmpl"
done

fileline '^set background=' 'set background=dark' "$HOME/.vimrc.local"

# Let btop inherit the terminal's ANSI palette.
if command -v btop >/dev/null 2>&1; then
	btopconf=$HOME/.config/btop/btop.conf
	mkdir -p "${btopconf%/*}"
	if [ ! -f "$btopconf" ]; then
		btop --default-config >"$btopconf" || {
			rm -f "$btopconf"
			fatal "create $btopconf"
		}
	fi
	fileline '^color_theme = ' 'color_theme = "TTY"' "$btopconf"
	fileline '^theme_background = ' 'theme_background = false' "$btopconf"
fi

# Plugin data list
plugins=$(mktemp) || fatal "mktemp failed"
cat >"$plugins" <<EOF
https://github.com/tpope/vim-eunuch
https://github.com/tpope/vim-fugitive
https://github.com/tpope/vim-repeat
https://github.com/tpope/vim-surround
-o https://github.com/fatih/vim-go
EOF

while read -r flag url; do
	if [ -n "$url" ]; then
		log "vim plugin $flag $url"
		./vim/get "$flag" "$url" </dev/null || fatal "vim plugin failed: $url"
	else
		log "vim plugin $flag"
		./vim/get "$flag" </dev/null || fatal "vim plugin failed: $flag"
	fi
done <"$plugins"

# Prune undeclared start/ plugins
startdir="$HOME/.vim/pack/default/start"
[ -d "$startdir" ] || { rm -f "$plugins"; exit 0; }
for dir in "$startdir"/*; do
	[ -d "$dir" ] || continue
	printf '%s\n' "${dir##*/}"
done | awk -v startdir="$startdir" '
	FNR==NR { if (!/^-o/) { n=split($1,a,"/"); declared[a[n]]=1 } next }
	$0 in declared { next }
	{ print "install: vim prune " $0 > "/dev/stderr"
	  system("rm -rf " startdir "/" $0) }
' "$plugins" -
rm -f "$plugins"
