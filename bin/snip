#!/usr/bin/env python3
"""Expand text snippets."""

import argparse
import glob
import importlib.util
import inspect
import os
import sys


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Expand text snippets.", add_help=False,
        epilog="Use %(prog)s SNIPPET -h for arguments and examples. "
               "Use -- before literal arguments starting with '-'.",
    )
    parser.add_argument("-h", "--help", action="store_true", help="show command or snippet help")
    parser.add_argument("-t", "--tab", default="\t", help="indent string")
    parser.add_argument(
        "-l", "--list", action="store_true", help="list available snippets"
    )
    parser.add_argument("snippet", nargs="?", help="name of the snippet to expand")
    parser.add_argument("args", nargs="*", help="arguments to pass to the snippet")

    args = parser.parse_args(argv)
    if args.help and not args.snippet:
        parser.print_help()
        return 0

    root = os.path.join(os.path.dirname(os.path.realpath(__file__)), "snip.d")
    snippets = load(root)

    if not args.snippet or (args.list and not args.help):
        listing(snippets)
        return 0

    func = snippets.get(args.snippet)
    if func is None:
        print(f"Unknown snippet: {args.snippet}", file=sys.stderr)
        listing(snippets)
        return 1

    if args.help:
        usage(args.snippet, func)
        return 0

    try:
        text = expand(func, args.args, args.tab)
    except ValueError as err:
        print(f"snip: {args.snippet}: {err}", file=sys.stderr)
        return 2
    print(text)
    return 0


def listing(snippets):
    if not snippets:
        return

    print("\nAvailable snippets:")
    width = max(map(len, snippets))
    for name, func in sorted(snippets.items()):
        summary = (inspect.getdoc(func) or "").partition("\n")[0]
        print(f"  {name:<{width}} - {summary}")


def usage(name, func):
    doc = inspect.getdoc(func) or ""
    summary, _, detail = doc.partition("\n\n")
    synopsis, _, body = detail.partition("\n\n")
    print(synopsis or f"usage: snip {name}")
    if summary:
        print(f"\n{summary}")
    if body:
        print(f"\n{body}")


def expand(func, args=None, tab="\t"):
    if args is None:
        args = []
    out = IndentBuilder(tab)
    result = func(out, args)
    return result if result is not None else out.text()


class IndentBuilder:
    def __init__(self, tab="\t"):
        self.tab = tab
        self.level = 0
        self.lines = []

    def write(self, line):
        if line:
            self.lines.append(self.tab * self.level + line)
        else:
            self.lines.append("")
        return self

    def block(self, text):
        """Write a template whose indentation uses tabs."""
        for line in text.strip("\n").splitlines():
            n = len(line) - len(line.lstrip("\t"))
            self.write(self.tab * n + line[n:])
        return self

    def indent(self):
        self.level += 1
        return self

    def dedent(self):
        if self.level < 1:
            raise IndentationError(
                f"Cannot dedent past level 0 at line {len(self.lines)}"
            )
        self.level -= 1
        return self

    def text(self):
        return "\n".join(self.lines)


def load(root):
    for name in list(sys.modules):
        if name == "snip_d" or name.startswith("snip_d."):
            del sys.modules[name]
    spec = importlib.util.spec_from_loader("snip_d", loader=None, is_package=True)
    package = importlib.util.module_from_spec(spec)
    package.__path__ = [root]
    sys.modules["snip_d"] = package

    snippets = {}
    for path in sorted(glob.glob(os.path.join(root, "*.py"))):
        name = os.path.basename(path)[:-3]
        spec = importlib.util.spec_from_file_location(f"snip_d.{name}", path)
        mod = importlib.util.module_from_spec(spec)
        sys.modules[spec.name] = mod
        spec.loader.exec_module(mod)
        snippets.update(getattr(mod, "SNIPPETS", {}))
    return snippets


if __name__ == "__main__":
    sys.exit(main())
