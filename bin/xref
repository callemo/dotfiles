#!/usr/bin/env python3
"""xref: update cross references in note files

Usage: xref [dir]

Scans .md and .txt files for [[wiki-links]], resolves each link to
the first case-insensitive match in sorted file order, and updates
existing frontmatter References: lines, clearing those with no incoming
links. Prints warnings to stderr for missing targets.
"""

import os
import re
import sys
from collections import defaultdict

link_re = re.compile(r'\[\[([0-9A-Za-z_/.-]+)\]\]')
prefix_re = re.compile(r'^(Z/R/n/|Z/R/)')


def files(root):
    result = []
    for dirpath, _, names in os.walk(root):
        for name in names:
            if name.endswith('.md') or name.endswith('.txt'):
                result.append(os.path.join(dirpath, name))
    result.sort()
    return result


def links(root):
    out = []
    for path in files(root):
        seen, ll = set(), []
        with open(path, encoding='utf-8', errors='replace') as f:
            for line in f:
                if line.strip().startswith('References:'):
                    continue
                for m in link_re.finditer(line):
                    t = m.group(1)
                    if t not in seen:
                        seen.add(t)
                        ll.append(t)
        if ll:
            out.append((path, ll))
    return out


def revlinks(root):
    raw = defaultdict(set)
    for src, targets in links(root):
        for t in targets:
            key = prefix_re.sub('', t)
            raw[key].add(src)

    return {k: sorted(v) for k, v in raw.items()}


def find(fs, key):
    pat = re.compile(r'(^|/)' + re.escape(key) + r'[^/]*$', re.IGNORECASE)
    return next((f for f in fs if pat.search(f)), None)


def stem(path, root):
    name = os.path.relpath(path, root)
    name = prefix_re.sub('', name)
    return re.sub(r'\.(md|txt)$', '', name)


def rewrite(text, refs):
    lines = text.splitlines(keepends=True)
    if not lines or lines[0].rstrip() != '---':
        return text
    end = next((i for i in range(1, len(lines))
                if lines[i].rstrip() == '---'), None)
    if end is None:
        return text

    for i in range(1, end):
        line = lines[i]
        if line.startswith('References:'):
            eol = line[len(line.rstrip('\r\n')):]
            lines[i] = (f'References: {refs}' if refs else 'References:') + eol
            break
    return ''.join(lines)


def run(root):
    root = os.path.realpath(root)
    fs = files(root)
    incoming = defaultdict(set)
    warnings = []

    for key, sources in revlinks(root).items():
        target = find(fs, key)
        if not target:
            names = ' '.join(f'[[{stem(s, root)}]]' for s in sources)
            warnings.append(f'file not found: following [[{key}]] from {names}')
            continue

        incoming[target].update(sources)

    for target in fs:
        refs = ' '.join(sorted({f'[[{stem(s, root)}]]' for s in incoming[target]}))
        with open(target, encoding='utf-8',
                  errors='surrogateescape', newline='') as f:
            text = f.read()
        new = rewrite(text, refs)
        if new == text:
            continue
        with open(target, 'w', encoding='utf-8',
                  errors='surrogateescape', newline='') as f:
            f.write(new)

    return warnings


if __name__ == '__main__':
    d = sys.argv[1] if len(sys.argv) > 1 else os.environ.get('NROOT', '.')
    for w in run(d):
        print('xref: ' + w, file=sys.stderr)
