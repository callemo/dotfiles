#!/bin/sh
# gbm: fast-forward BRANCH from its remote, then merge it into HEAD.
set -eu

prefix="${0##*/}:"
die() { echo "$prefix" "$@" >&2; exit 1; }

[ $# -eq 1 ] || die "usage: $prefix <branch>"
merge="$1"
here="$(git symbolic-ref --short HEAD)"

git fetch --prune --no-write-fetch-head origin
git checkout "$merge"
git pull --ff-only
git checkout "$here"
git merge --no-ff -m "Merge $merge" "$merge"
