#!/bin/sh
# gst: git status against remote refs fetched in the last five minutes.

mtime() {
	stat -c %Y "$1" 2>/dev/null || stat -f %m "$1"
}

if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
	fh=$(git rev-parse --git-path FETCH_HEAD)
	if [ ! -f "$fh" ] ||
		[ "$(date +%s)" -ge "$(( $(mtime "$fh") + 300 ))" ]
	then
		git fetch --quiet --prune 2>/dev/null
	fi
fi

exec git status "$@"
