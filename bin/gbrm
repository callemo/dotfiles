#!/bin/sh
# gbrm: remove a local branch and its remote
set -eu

prefix="${0##*/}:"
log() { echo "$prefix" "$@" >&2; }
die() { log "$@"; exit 1; }

[ $# -ne 1 ] && die "usage: $prefix <branch>"
name="$1"
remote=origin
{
	git branch -a | grep -F "$name" || die 'no branch matches:' "$name"
	log "deleting: $name"
	git branch -D "$name"
	log "deleting: $remote/$name"
	git push "$remote" -d "$name"
} >&2
