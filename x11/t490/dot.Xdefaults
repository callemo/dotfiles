! dot.Xdefaults
XTerm*loginShell:         true
XTerm*allowMouseOps:      true
XTerm*termName:           xterm-256color
XTerm*faceName:           JetBrains Mono:style=Light
XTerm*faceSize:           10
XTerm*foreground:         #d4be98
XTerm*background:         #282828
XTerm*cursorColor:        #bdae93
XTerm*cursorColor2:       #282828
XTerm*pointerColor:       #bdae93
XTerm*pointerColorBackground: #282828
XTerm*highlightColor:     #504945
XTerm*highlightTextColor: #fbf1c7
XTerm*highlightColorMode: true
XTerm*highlightReverse:   false
XTerm*faceSize1:          7
XTerm*faceSize2:          8
XTerm*faceSize3:          9
XTerm*faceSize4:          10
XTerm*faceSize5:          11
XTerm*faceSize6:          12
XTerm*faceSize7:          13
XTerm*vt100.translations: #override \n\
    Shift Ctrl <Key> C: copy-selection(CLIPBOARD) \n\
    Shift Ctrl <Key> V: insert-selection(CLIPBOARD)

XClock*geometry:   128x128+0+0
XClock*background: #282828
XClock*foreground: #d4be98
XClock*hands:      #d4be98
XClock*highlight:  #7daea3
XClock*majorColor: #bdae93
XClock*minorColor: #928374

XConsole*geometry:    700x40
XConsole*foreground:  #d8a657
XConsole*background:  #282828
XConsole*cursorColor: #d8a657
XConsole*saveLines:   8

! xlock: echo a star per keystroke at the password prompt
xlock*echokeys:        on
xlock*echokey:         *
! enable DPMS on start, disable on exit so it does not persist
xlock*startCmd:        xset +dpms
xlock*endCmd:          xset -dpms

*font: -adobe-courier-bold-r-*-*-17-*-*-*-*-*-*-*
*Scrollbar.translations: #override \n\
    <Btn1Down>:         StartScroll(Backward) \n\
    <Btn3Down>:         StartScroll(Forward) \n\
    <BtnUp>:            NotifyScroll(Proportional) EndScroll()
*scrollbar.background:    #3c3836
*scrollbar.foreground:    #928374

! Gruvbox Material color scheme
*color0:  #3c3836
*color1:  #ea6962
*color2:  #a9b665
*color3:  #d8a657
*color4:  #7daea3
*color5:  #d3869b
*color6:  #89b482
*color7:  #d4be98
*color8:  #928374
*color9:  #ea6962
*color10: #a9b665
*color11: #d8a657
*color12: #7daea3
*color13: #d3869b
*color14: #89b482
*color15: #d4be98

! ToolStatus bar
ToolStatus*background:     #282828
ToolStatus*foreground:     #d4be98
ToolStatus*faceName:       JetBrains Mono:style=Semibold
ToolStatus*faceSize:       9
ToolStatus*scrollBar:      false
ToolStatus*borderWidth:    0
ToolStatus*internalBorder: 2
ToolStatus*geometry:       26x1

Xft.dpi: 144
Xcursor.theme: Adwaita
Xcursor.size: 32
Xft.autohint: 0
Xft.lcdfilter:  lcddefault
Xft.hintstyle:  hintfull
Xft.hinting: 1
Xft.antialias: 1
Xft.rgba: rgb
