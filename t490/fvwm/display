#!/bin/sh
# display: switch or sync internal/external profiles

prefix="${0##*/}:"
cachedir=${XDG_CACHE_HOME:-$HOME/.cache}
logfile=${FVWM_LOG:-$cachedir/fvwm.log}

log() {
	echo "$prefix" "$@" >&2
	ts=$(date '+%Y-%m-%d %H:%M:%S')
	printf '%s %s %s\n' "$ts" "$prefix" "$*" >>"$logfile" 2>/dev/null
	[ -d "$cachedir" ] || mkdir -p "$cachedir"
}
die() { log "$@"; exit 1; }

try() {
	"$@"
	rc=$?
	[ $rc -eq 0 ] || log "failed($rc): $*"
	return $rc
}

must() {
	"$@"
	rc=$?
	[ $rc -eq 0 ] || die "failed($rc): $*"
}

cmd=${1:-toggle}
emit=${2:-}
restart=${3:-auto}
int='eDP-1'
root=${DOTFILES:-$HOME/dotfiles}
fvwmroot=$root/t490/fvwm
PATH="$root/bin:$PATH"
export PATH
. "$fvwmroot/profile" || exit 1
. "$root/lib/install" || exit 1

[ "$(uname)" = OpenBSD ] || die 'not running openbsd'

xr=$(xrandr) || die 'xrandr failed'
ext=$(printf '%s\n' "$xr" | awk -v panel="$int" \
	'$2 == "connected" && $1 != panel { print $1; exit }')
active=$(printf '%s\n' "$xr" | awk -v panel="$int" '
	$2 == "connected" && $1 != panel {
		for (j = 1; j <= NF; j++)
			if ($j ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {
				print $1
				exit
			}
	}
')
[ -n "$active" ] && ext=$active
curmode=$(printf '%s\n' "$xr" | awk -v out="$active" '
	$1 == out {
		for (j = 1; j <= NF; j++)
			if ($j ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {
				sub(/\+.*/, "", $j)
				print $j
				exit
			}
	}
')
mode=$(printf '%s\n' "$xr" | awk -v out="$ext" '
	$1 == out { found = 1; next }
	found && $1 !~ /^[0-9]+x[0-9]+$/ { exit }
	found && /\+/ { print $1; exit }
')

log "state ext=${ext:-none} active=${active:-none}" \
	"curmode=${curmode:-none} mode=${mode:-auto} cmd=$cmd"
printf '%s\n' "$xr" | while IFS= read -r line; do
	case $line in *connected*) log "xrandr: $line" ;; esac
done

fvwm() {
	[ "$emit" = fvwm ] || return
	printf '%s\n' "$@"
}

restart() {
	[ "$restart" = no ] && return 1
	[ "$restart" = yes ] && return 0
	case $cmd in
	sync|apply) return 1 ;;
	esac
	return 0
}

kick() {
	restart || return 0
	[ "$emit" = fvwm ] && {
		fvwm 'Restart fvwm'
		log 'restart fvwm command emitted'
		return
	}
	pids=$(pgrep -u "$(id -un)" -x fvwm 2>/dev/null) || {
		log 'restart skipped: no fvwm pid'
		return
	}
	pids=$(printf '%s' "$pids" | tr '\n' ' ')
	try kill -USR1 $pids && log "restart fvwm pid=$pids"
}

gtkfont() {
	config=${XDG_CONFIG_HOME:-$HOME/.config}
	for version in 3 4; do
		settings=$config/gtk-$version.0/settings.ini
		mkdir -p "${settings%/*}" || return 1
		[ -f "$settings" ] || printf '[Settings]\n' >"$settings" || return 1
		fileline '^gtk-font-name=' "gtk-font-name=$gtkfont" "$settings" || return
	done
	fileline '^gtk-font-name=' "gtk-font-name=\"$gtkfont\"" "$HOME/.gtkrc-2.0"
}

scale() {
	cat <<EOF | xrdb -merge
Xft.dpi: $dpi
Xcursor.size: $cursor
XTerm*faceName: Spleen:pixelsize=$pixels:antialias=false,DejaVu Sans Mono:pixelsize=$pixels:antialias=false
XTerm*font: spleen-$((pixels / 2))x$pixels
ToolStatus*font: spleen-$((pixels / 2))x$pixels
ToolStatus*internalBorder: $padding
EOF
	gtkfont || die 'setting GTK font failed'
	try xrandr --dpi "$dpi"
	XCURSOR_SIZE=$cursor xsetroot -cursor_name left_ptr 2>/dev/null || true
	fvwm "SetEnv XCURSOR_SIZE $cursor" \
		'SetEnv QT_FONT_DPI 96' \
		"SetEnv QT_SCALE_FACTOR $qt" \
		"DefaultFont \"$fvwmfont\"" \
		"MenuStyle * Font \"$menufont\"" \
		"*FvwmPagerFont $fvwmfont" \
		"*FvwmPagerGeometry $((barheight * 6))x$barheight+0+0"
	log "scale: dpi=$dpi cursor=$cursor qt=$qt xterm=$pixels"
}

wallpaper() {
	pic=$fvwmroot/bg.png
	[ -f "$pic" ] || return
	command -v xwallpaper >/dev/null 2>&1 || return
	xwallpaper --zoom "$pic" 2>/dev/null || true
	log 'wallpaper zoomed'
}

mouse() {
	xinput list --name-only |
		awk '/^\/dev\/wsmouse/ { print }' |
		while IFS= read -r dev; do
			try xinput set-prop "$dev" \
				'Device Accel Constant Deceleration' 1
			map=$(xinput get-button-map "$dev" 2>/dev/null) || continue
			set -- $map
			[ $# -ge 7 ] && try xinput set-button-map \
				"$dev" 1 2 3 4 5 6 7
		done
}

# external output wants a mode its current display lacks
stale() {
	[ -n "$active" ] && [ -n "$mode" ] && [ "$curmode" != "$mode" ]
}

setext() {
	[ -n "$active" ] && try xrandr --output "$active" --primary
	profile external
	scale
	wallpaper
	mouse
}

setint() {
	profile internal
	scale
	wallpaper
	mouse
}

useext() {
	[ -n "$ext" ] || die 'no external display connected'
	log "$ext ${mode:-preferred} on, $int off"
	if [ -n "$mode" ]; then
		must xrandr --output "$ext" --primary --mode "$mode" \
			--output "$int" --off
	else
		must xrandr --output "$ext" --primary --auto \
			--output "$int" --off
	fi
	active=$ext
	setext
}

useint() {
	log "$int on${ext:+, $ext off}"
	if [ -n "$ext" ]; then
		must xrandr --output "$int" --primary --auto \
			--output "$ext" --off
	else
		must xrandr --output "$int" --primary --auto
	fi
	active=
	setint
}

sync() {
	stale && { useext; return; }
	[ -n "$active" ] && { setext; return; }
	setint
}

toggle() {
	stale && { useext; return; }
	[ -n "$active" ] && { useint; return; }
	[ -n "$ext" ] || { useint; return; }
	useext
}

case $cmd in
toggle) toggle ;;
sync|apply) sync ;;
external|ext) useext ;;
internal|int) useint ;;
*) die 'usage: display [toggle|sync|external|internal]' \
	'[fvwm] [auto|yes|no]' ;;
esac

kick
