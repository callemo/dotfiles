#!/bin/sh
# fvwm toolbar: pager left, status right

root=${DOTFILES:-$HOME/dotfiles}
fvwmroot=$root/t490/fvwm
. "$fvwmroot/profile" || exit 1
profile
# FvwmButtons columns are two pixels wide.
pager=$((barheight * 3))
cellwidth=$((pixels / 2))
status=$(((29 * cellwidth + 2 * padding + 1) / 2))

dims=$(xdpyinfo | awk '/dimensions:/{print $2; exit}')
w=${dims%x*}; w=${w:-1920}
cols=$((w / 2))

cat <<EOF
*ToolBarBack #282828
*ToolBarFore #f9f5d7
*ToolBarFont $fvwmfont
*ToolBarGeometry ${w}x${barheight}+0+0
*ToolBarRows 1
*ToolBarColumns $cols
*ToolBarBoxSize fixed
*ToolBarFrame 0
*ToolBarPadding 0 0
*ToolBar(${pager}x1+0+0, Frame 0, Padding 0 0, Swallow(NoHints) "FvwmPager" \
	"FvwmPager 0 4")
*ToolBar(${status}x1-0+0, Frame 0, Padding 0 0, \
	Swallow(NoHints) "ToolStatus" \
	"Exec exec $fvwmroot/statwin")
EOF
