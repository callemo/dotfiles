#!/bin/sh

file=${1-}
[ -f "$file" ] || exit 1
command -v lowdown >/dev/null 2>&1 || {
	/usr/X11R6/bin/xmessage 'Markdown preview requires lowdown.'
	exit 1
}
[ -x /usr/X11R6/bin/xterm ] || exit 1

exec /usr/X11R6/bin/xterm \
	-title "Preview: ${file##*/}" \
	-geometry 90x32 \
	-xrm 'XTerm*vt100.translations: #override \n\
		<Key>space: string("q") \n\
		<Key>Escape: string("q")' \
	-e sh -c 'lowdown -t term "$1" | LESSSECURE=1 LESSHISTFILE=- less -R' sh "$file"
