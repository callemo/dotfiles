# dot.fvwmrc
# See fvwm(1) and examples in /usr/X11R6/lib/X11/fvwm
# vim: fdm=marker et
ModulePath /usr/X11R6/lib/X11/fvwm

ColormapFocus  FollowsMouse
SnapAttraction 10 Windows
OpaqueMoveSize 100
GlobalOpts MouseFocusClickRaises

DeskTopSize    1x1
EdgeThickness 0
EdgeResistance 300 10

DefaultFont "-adobe-helvetica-medium-r-normal--20-140-100-100-p-100-iso10646-1"
HilightColor #282828 #b22222
MenuStyle * mwm, Hilight3DThin, SeparatorsLong, TrianglesSolid, \
            Foreground #f9f5d7, Background #282828, Greyed #928374, \
            HilightBack #665c54, ActiveFore #f9f5d7, \
            Font "-misc-spleen-medium-r-normal--24-240-72-72-c-120-iso10646-1"

AddToFunc StartFunction
    + "I" PipeRead '$HOME/dotfiles/t490/fvwm/display sync fvwm'
    + "I" Module FvwmButtons ToolBar

# Styles {{{
Style "*" BorderWidth 7, HandleWidth 7, BackColor #4682b4, \
          NoTitle, \
          DecorateTransient, \
          HintOverride, \
          NoIcon, \
          NoPPosition, \
          MouseFocus, \
          SmartPlacement, RandomPlacement

BorderStyle Simple -- HiddenHandles !NoInset

Style "Fvwm*"    NoTitle, Sticky, WindowListSkip, CirculateSkip, \
                 CirculateSkipIcon
Style "ToolStatus" NoTitle, NoHandles, BorderWidth 0, Sticky, \
                   WindowListSkip, CirculateSkip, CirculateSkipIcon
Style "ToolBar" NoTitle, NoHandles, BorderWidth 0, Sticky, \
                WindowListSkip, CirculateSkip, CirculateSkipIcon
Style "xconsole" WindowListSkip, CirculateSkip, Sticky
# }}}
# Bindings {{{
# Mouse {{{
#     Button Context Modifiers Function
Mouse 1      R       A         Menu RootMenu Nop
Mouse 2      R       A         WindowList
Mouse 3      R       A         Menu RootMenu Nop

Mouse 1      FS      A         RaiseAndResize
Mouse 1      I       A         IconifyOrMove
Mouse 1      W       4         RaiseAndMove
Mouse 2      WTSF    4         Menu WinOps Nop
Mouse 3      W       4         Lower
Mouse 3      W       M         Lower
Mouse 2      I       A         Iconify
Mouse 3      TSF     N         Menu WinOps Nop
Mouse 3      I       A         RaiseLower

# }}}
# Keyboard {{{
# Names come from /usr/X11R6/include/X11/keysymdef.h
#   Name   Context Modifiers Function

# Apps
Key Return A       S4        Function OpenTerminal
Key B      A       S4        Exec exec chrome
Key V      A       S4        Exec exec xterm -e ksh -lc vim
Key F      A       S4        Exec exec thunar
Key T      A       C4        Function Btop

# Menus / launcher
Key space  A       4         Module FvwmForm RunCmd
Key space  A       M4        Menu RootMenu Nop
Key space  W       M         Menu WinOps Nop
Key slash  A       4         WindowList
Key Escape A       4         Module FvwmForm LogOut

# Window management
Key W      A       4         Delete
Key M      A       4         Iconify
Key F      A       4         PipeRead '$HOME/dotfiles/t490/fvwm/zoom $w below'
Key F      A       C4        PipeRead '$HOME/dotfiles/t490/fvwm/zoom $w vertical'
Key F      A       M4        PipeRead '$HOME/dotfiles/t490/fvwm/zoom $w full'
Key H      A       4         Move w-10p w+0p Warp
Key J      A       4         Move w+0p w+10p Warp
Key K      A       4         Move w+0p w-10p Warp
Key L      A       4         Move w+10p w+0p Warp
Key H      A       S4        PipeRead '$HOME/dotfiles/t490/fvwm/resize $w -10 0'
Key J      A       S4        PipeRead '$HOME/dotfiles/t490/fvwm/resize $w 0 10'
Key K      A       S4        PipeRead '$HOME/dotfiles/t490/fvwm/resize $w 0 -10'
Key L      A       S4        PipeRead '$HOME/dotfiles/t490/fvwm/resize $w 10 0'
Key Left   A       C4        Move 0 w+0 Warp
Key Right  A       C4        Move -0 w+0 Warp
Key Up     A       C4        Move w+0 30p Warp
Key Down   A       C4        Move w+0 -0 Warp

# Focus
Key Tab    A       M         Next (CurrentPage !Iconic) Function SelectWindow
Key Tab    A       SM        Prev (CurrentPage !Iconic) Function SelectWindow

# Desks
Key Left   A       4         Desk -1 0 0 4
Key Right  A       4         Desk 1 0 0 4
Key Left   W       S4        PipeRead '$HOME/dotfiles/t490/fvwm/shift-desk $w -1'
Key Right  W       S4        PipeRead '$HOME/dotfiles/t490/fvwm/shift-desk $w 1'
Key Tab    A       4         Next (CurrentPage !Iconic) Function SelectWindow
Key Tab    A       S4        Prev (CurrentPage !Iconic) Function SelectWindow
Key 1      A       4         Desk 0 0
Key 2      A       4         Desk 0 1
Key 3      A       4         Desk 0 2
Key 4      A       4         Desk 0 3
Key 5      A       4         Desk 0 4

# System
Key L      A       C4        Exec exec xlock -echokeys -echokey \*
Key N      A       C4        Exec sh -c '[ $(date +%H) -ge 19 ] || [ $(date +%H) -lt 7 ] && sct 3200 || sct 5600'

Key Delete A       C4        PipeRead '$HOME/dotfiles/t490/fvwm/display toggle fvwm'
# }}}
# }}}
# Menus {{{
AddToMenu RootMenu "Control Menu" Title
+ "Terminal	Shift-Win-Return"      Function OpenTerminal
+ "Web Browser	Shift-Win-B"       Exec exec chrome
+ "Files	Shift-Win-F"           Exec exec thunar
+ ""                               Nop
+ "Run...	Win-Space"             Module FvwmForm RunCmd
+ "Key bindings"                   Menu KeyBindingsMenu Nop
+ "Window list	Win-Slash"         WindowList
+ ""                               Nop
+ "Toggle display	Ctrl-Win-Delete" PipeRead '$HOME/dotfiles/t490/fvwm/display toggle fvwm'
+ "Lock display	Ctrl-Win-L"      Exec exec xlock -echokeys -echokey \*
+ "Log out...	Win-Escape"        Module FvwmForm LogOut
+ "Restart fvwm"                   Restart fvwm

AddToMenu KeyBindingsMenu "Key Bindings" Title
+ "Navigation" Title
+ "Run command...	Win-Space" Module FvwmForm RunCmd
+ "Control menu	Alt-Win-Space" Menu RootMenu Nop
+ "Log out...	Win-Escape" Module FvwmForm LogOut
+ "Window list	Win-Slash" WindowList
+ "Lock computer	Ctrl-Win-L" Exec exec xlock -echokeys -echokey \*
+ "" Nop
+ "Apps" Title
+ "Terminal	Shift-Win-Return" Function OpenTerminal
+ "Browser	Shift-Win-B" Exec exec chrome
+ "Vim	Shift-Win-V" Exec exec xterm -e ksh -lc vim
+ "Files	Shift-Win-F" Exec exec thunar
+ "System monitor	Ctrl-Win-T" Function Btop
+ "" Nop
+ "Windows" Title
+ "Close	Win-W" Delete
+ "Minimize	Win-M" Iconify
+ "Zoom below bar	Win-F" PipeRead '$HOME/dotfiles/t490/fvwm/zoom $w below'
+ "Zoom vertical below bar	Ctrl-Win-F" PipeRead '$HOME/dotfiles/t490/fvwm/zoom $w vertical'
+ "Zoom to screen	Alt-Win-F" PipeRead '$HOME/dotfiles/t490/fvwm/zoom $w full'
+ "Move window 10 pixels	Win-H/J/K/L" Nop
+ "Resize window 10 pixels	Shift-Win-H/J/K/L" Nop
+ "Move to edge	Ctrl-Win-Arrows" Nop
+ "Raise window	Left Click" Nop
+ "Move window	Win-Left Drag" Nop
+ "Window menu	Alt-Space / Right Click border" Menu WinOps Nop
+ "Lower window	Win-Right Click / Win-Double-Left Click" Nop
+ "" Nop
+ "Focus" Title
+ "Next window	Alt-Tab / Win-Tab" Next (CurrentPage !Iconic) Function SelectWindow
+ "Previous window	Shift-Alt-Tab / Shift-Win-Tab" Prev (CurrentPage !Iconic) Function SelectWindow
+ "" Nop
+ "Workspaces" Title
+ "Previous workspace	Win-Left" Desk -1 0 0 4
+ "Next workspace	Win-Right" Desk 1 0 0 4
+ "Move window and follow	Shift-Win-Left/Right" Nop
+ "Workspace 1	Win-1" Desk 0 0
+ "Workspace 2	Win-2" Desk 0 1
+ "Workspace 3	Win-3" Desk 0 2
+ "Workspace 4	Win-4" Desk 0 3
+ "Workspace 5	Win-5" Desk 0 4
+ "" Nop
+ "System / hardware" Title
+ "Nightlight	Ctrl-Win-N" Exec sh -c '[ $(date +%H) -ge 19 ] || [ $(date +%H) -lt 7 ] && sct 3200 || sct 5600'
+ "Restart fvwm	Alt-Win-Space menu" Restart fvwm
+ "Toggle display	Ctrl-Win-Delete" PipeRead '$HOME/dotfiles/t490/fvwm/display toggle fvwm'

AddToMenu WinOps "Window" Title
+ "Iconify"    Iconify
+ "Resize"     Resize
+ "Move"       Move
+ ""           Nop
+ "Occupy All" Stick
+ ""           Nop
+ "Raise"      Raise
+ "Lower"      Lower
+ ""           Nop
+ "Zoom"       PipeRead '$HOME/dotfiles/t490/fvwm/zoom $w full'
+ "Zoom-V"     PipeRead '$HOME/dotfiles/t490/fvwm/zoom $w vertical'
+ "Zoom-H"     PipeRead '$HOME/dotfiles/t490/fvwm/zoom $w horizontal'
+ ""           Nop
+ "Kill"       Destroy
+ "Close"      Close
# }}}
# Functions {{{
AddToFunc RaiseAndMove
    + I Raise
    + M Move
    + D Lower

AddToFunc RaiseAndResize
    + I Raise
    + M Resize
    + D Lower


AddToFunc SelectWindow
    + I FlipFocus
    + I Raise
    + I WarpToWindow 50 50

DestroyFunc WindowListFunc
AddToFunc WindowListFunc
    + I WindowId $0 Iconify -1
    + I WindowId $0 FlipFocus
    + I WindowId $0 Raise
    + I WindowId $0 WarpToWindow 50 50

AddToFunc IconifyOrMove
    + I Raise
    + C Iconify
    + M Move

AddToFunc OpenTerminal
    + I Exec exec xterm
    + I Wait xterm
    + I Next (xterm) SelectWindow

AddToFunc Btop
    + I Exec exec xterm -name btop -geometry 110x35 -e btop
    + I Wait btop
    + I Next (btop) Move 50-437p 50-300p

# }}}
# Modules {{{
# ToolBar {{{
PipeRead '$HOME/dotfiles/t490/fvwm/bar 30'
# }}}
# Pager {{{
*FvwmPagerFont "-adobe-helvetica-medium-r-normal--20-140-100-100-p-100-iso10646-1"
*FvwmPagerGeometry 180x30+0+0
*FvwmPagerRows 1
*FvwmPagerColumns 5
*FvwmPagerSmallFont none
*FvwmPagerFore #f9f5d7
*FvwmPagerBack #282828
*FvwmPagerHilight #665c54
*FvwmPagerLabel 0 "1"
*FvwmPagerLabel 1 "2"
*FvwmPagerLabel 2 "3"
*FvwmPagerLabel 3 "4"
*FvwmPagerLabel 4 "5"
Style "FvwmPager"   NoHandles, BorderWidth 0
# }}}
# Form {{{
# LogOut {{{
*LogOutGrabServer
*LogOutWarpPointer
*LogOutFore       #f9f5d7
*LogOutBack       #000000
*LogOutItemFore   #f9f5d7
*LogOutItemBack   #282828
*LogOutFont       -adobe-helvetica-medium-r-normal--20-140-100-100-p-100-iso10646-1
*LogOutButtonFont -adobe-helvetica-medium-r-normal--20-140-100-100-p-100-iso10646-1
*LogOutCommand    Beep
*LogOutLine       left
*LogOutText       "Are you sure you want to quit all applications"
*LogOutLine       left
*LogOutText       "and log out now?"
*LogOutLine       right
*LogOutButton     quit "Cancel" ^[
*LogOutCommand    Nop
*LogOutButton     quit "Log Out" ^M
*LogOutCommand    Quit
Style "LogOut" NoTitle, NoHandles
# }}}
# RunCmd {{{
*RunCmdWarpPointer
*RunCmdFore       #f9f5d7
*RunCmdBack       #000000
*RunCmdItemFore   #f9f5d7
*RunCmdItemBack   #282828
*RunCmdFont       -adobe-helvetica-medium-r-normal--20-140-100-100-p-100-iso10646-1
*RunCmdButtonFont -adobe-helvetica-medium-r-normal--20-140-100-100-p-100-iso10646-1
*RunCmdInputFont  -adobe-courier-bold-r-normal--25-180-100-100-m-150-iso10646-1
*RunCmdLine       center
*RunCmdText       "Run"
*RunCmdLine       left
*RunCmdInput      Cmd  50 ""
*RunCmdLine       right
*RunCmdButton     quit "Cancel" ^[
*RunCmdCommand    Nop
*RunCmdButton     quit "Run" ^M
*RunCmdCommand    exec $(Cmd)
Style "RunCmd" NoTitle, NoHandles
# }}}
# }}}
# }}}
